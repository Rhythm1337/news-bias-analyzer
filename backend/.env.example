# Cloud Postgres connection string. Get one from Neon (https://neon.tech), Supabase, Railway, etc.
# IMPORTANT: must use the psycopg driver scheme. If your provider gives you "postgres://...",
# change the prefix to "postgresql+psycopg://..."
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
CORS_ORIGIN=http://localhost:3000

AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# Full /v2/models/<name>/infer URL of an OpenShift AI InferenceService (set AI_PROVIDER=openshift to use).
OPENSHIFT_AI_INFERENCE_URL=
# OpenShift OAuth bearer token for the InferenceService route; leave blank for unauthenticated routes.
OPENSHIFT_AI_TOKEN=

# Optional. When the direct article fetch is blocked (403, Cloudflare),
# we retry through ScrapingBee. Free tier: 1000 requests per month at
# https://www.scrapingbee.com. Leave empty to disable the fallback.
SCRAPINGBEE_API_KEY=

# Set to true ONLY when running behind a trusted reverse proxy (e.g. Render),
# so the rate limiter keys on the real client IP from X-Forwarded-For.
# TRUST_X_FORWARDED_FOR=true

# Number of trusted reverse proxies between the public internet and this app.
# 1 = one trusted proxy in front (e.g. Render directly).
# 2 = your proxy is itself behind another trusted proxy (e.g. Render behind
#     Cloudflare). The rate limiter reads the entry this many positions from
# the right of X-Forwarded-For. Defaults to 1 if unset.
# TRUSTED_PROXY_HOPS=1
